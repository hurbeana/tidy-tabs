{
  "name": "tidy-tabs",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "An AI tab grouper for Chrome and Firefox that runs fully on your own computer",
  "license": "MIT",
  "scripts": {
    "setup": "./setup.sh",
    "test": "node test/all.mjs",
    "test:quick": "node test/run.mjs && node test/wiring.mjs",
    "test:browser": "node test/browser.mjs",
    "lint": "eslint .",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --no-config-discovery",
    "check": "npm run lint && npm run test:quick",
    "build": "./build.sh",
    "dev:firefox": "web-ext run --source-dir dist/firefox"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "^3.8.1",
    "eslint": "^10.9.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.11.0",
    "puppeteer-core": "^24.0.0",
    "web-ext": "^10.6.0"
  }
}
